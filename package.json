{
  "name": "agent-commons",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Commons — cross-organization autonomous agent negotiation room with verifiable result cards (AI Builder Cup 2026).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test '.tmp-tests/tests/**/*.test.js'",
    "verify:hash": "node scripts/verify-hash.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:transport": "node --import tsx scripts/firestore-transport-check.mts",
    "emulator:firestore": "node --import tsx scripts/firestore-emulator.mts"
  },
  "dependencies": {
    "@google/genai": "^2.29.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firestore-emulator/server": "^0.3.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
